# Leave MA_URL blank to disable automatic Music Assistant synchronization.
# Use an address reachable from the sorter container (not localhost for another container).
MA_URL=
MA_TOKEN=
# Provider INSTANCE IDs from Music Assistant's provider settings, not display names.
# Leave a provider blank to skip syncing that library.
MA_MUSIC_PROVIDER=
MA_AUDIOBOOK_PROVIDER=
MA_SYNC_DEBOUNCE_SECONDS=30
MA_SYNC_TIMEOUT_SECONDS=5
MA_SYNC_RETRY_SECONDS=30

# Optional alternative to MA_TOKEN: path INSIDE the container to a mounted secret.
# Add a read-only mount or Docker secret in a Compose override before setting this.
MA_TOKEN_FILE=
